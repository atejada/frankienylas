def nylas_list_calendars(client, grant_id, params: {})
  _nylas_get(client, grant_id, "/calendars", params: params)
end

def nylas_get_calendar(client, grant_id, calendar_id)
  _nylas_get(client, grant_id, "/calendars/#{calendar_id}")
end

## `nylas_create_calendar(client, grant_id, body)` — body: {name:, description:, timezone:}.
def nylas_create_calendar(client, grant_id, body)
  _nylas_post(client, grant_id, "/calendars", body)
end

def nylas_update_calendar(client, grant_id, calendar_id, body)
  _nylas_put(client, grant_id, "/calendars/#{calendar_id}", body)
end

def nylas_delete_calendar(client, grant_id, calendar_id)
  _nylas_delete(client, grant_id, "/calendars/#{calendar_id}")
end

## ── Events ──────────────────────────────────────────────────────────────
## Every Events endpoint is scoped by calendar_id (Nylas requires it as a
## query param), so it's an explicit argument here rather than buried in
## `params`.

## `nylas_list_events(client, grant_id, calendar_id, params:)` — params:
## e.g. {start: unix_ts, end: unix_ts, limit: 20}.
def nylas_list_events(client, grant_id, calendar_id, params: {})
  q = params.merge({calendar_id: calendar_id})
  _nylas_get(client, grant_id, "/events", params: q)
end

def nylas_get_event(client, grant_id, calendar_id, event_id)
  _nylas_get(client, grant_id, "/events/#{event_id}", params: {calendar_id: calendar_id})
end

## `nylas_create_event(client, grant_id, calendar_id, body)` — body: e.g.
## {title:, when: {start_time:, end_time:}, participants: [{email:}]}.
def nylas_create_event(client, grant_id, calendar_id, body)
  _nylas_post(client, grant_id, "/events", body, params: {calendar_id: calendar_id})
end

def nylas_update_event(client, grant_id, calendar_id, event_id, body)
  _nylas_put(client, grant_id, "/events/#{event_id}", body, params: {calendar_id: calendar_id})
end

def nylas_delete_event(client, grant_id, calendar_id, event_id)
  _nylas_delete(client, grant_id, "/events/#{event_id}", params: {calendar_id: calendar_id})
end

## `nylas_rsvp_event(client, grant_id, calendar_id, event_id, status)` —
## status: "yes", "no", or "maybe".
def nylas_rsvp_event(client, grant_id, calendar_id, event_id, status)
  _nylas_post(client, grant_id, "/events/#{event_id}/send-rsvp", {status: status}, params: {calendar_id: calendar_id})
end

## ── Contacts ────────────────────────────────────────────────────────────

## `nylas_list_contacts(client, grant_id, params:)` — params: e.g.
## {limit: 10} or {email: "friend@example.com"} to search.
def nylas_list_contacts(client, grant_id, params: {})
  _nylas_get(client, grant_id, "/contacts", params: params)
end

