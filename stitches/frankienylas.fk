## frankienylas.fk — a thin Frankie stitch over the Nylas v3 REST API
## (Email, Calendar, Contacts). Zero dependencies — built entirely on
## Frankie's own http_get/post/put/delete + json, same as core stitches.
##
## ⚠️  v1 — API KEY ONLY. Built during Frankie's language freeze
## (see the core repo's CLAUDE.md), so this first version deliberately
## keeps to the smallest useful surface: a Nylas API key + a grant_id,
## no OAuth dance. Full OAuth 2.0 (connecting end-user accounts via the
## hosted auth flow) is on the roadmap for a v2 — see README.md.
##
## Setup: you need a Nylas API key and a grant_id (the id of a connected
## mailbox). Get both from the Nylas dashboard or `nylas init` (CLI).
## https://developer.nylas.com/docs/v3/getting-started/
##
## Usage:
##
##   stitch "frankienylas"
##
##   nylas = nylas_client(env("NYLAS_API_KEY"))
##   grant = env("NYLAS_GRANT_ID")
##
##   inbox = nylas_list_messages(nylas, grant, params: {limit: 10})
##   nylas_send_message(nylas, grant, {
##     to: [{email: "friend@example.com"}],
##     subject: "Hello from Frankie",
##     body: "Sent with frankienylas."
##   })
##
## Every call raises NylasApiError on a non-2xx response (with Nylas's
## own error message when the API provides one) and lets network-level
## RuntimeErrors (timeouts, DNS, etc.) propagate as-is from http_get/post.

error NylasApiError

NYLAS_REGIONS = {us: "https://api.us.nylas.com", eu: "https://api.eu.nylas.com"}

## `nylas_client(api_key, region:)` — configuration hash passed to every
## other function. `region` is "us" (default) or "eu" — pick whichever
## matches where your Nylas application was created.
def nylas_client(api_key, region: "us")
  base = NYLAS_REGIONS[region]
  raise NylasApiError, "nylas_client: unknown region \"#{region}\" — use \"us\" or \"eu\"" if base == nil
  {api_key: api_key, base_url: base}
end

def _nylas_headers(client)
  h = {}
  h["Authorization"] = "Bearer #{client["api_key"]}"
  h
end

def _nylas_query(params)
  return "" if params == nil or params.size == 0
  "?" + url_encode(params)
end

def _nylas_url(client, grant_id, path, params: {})
  "#{client["base_url"]}/v3/grants/#{grant_id}#{path}#{_nylas_query(params)}"
end

## Every response funnels through here: parses JSON on success, raises
## NylasApiError (with Nylas's own message when present) on failure.
##
## Note: this uses json_parse(resp.body) rather than resp.json() —
## Frankie's codegen currently treats a bare `.json` name as a property
## access (borrowed from FrankieRequest.json) even when called as
## `resp.json()`, so the call never actually fires and you silently get
## a bound-method object back instead of a hash. Filed as a core bug;
## json_parse(resp.body) sidesteps it entirely and is equally correct.
def _nylas_result(resp)
  return nil if resp.status == 204
  parsed = nil
  begin
    parsed = json_parse(resp.body)
  rescue
    parsed = nil
  end
  if resp.ok()
    return parsed["data"] if parsed != nil and parsed["data"] != nil
    return parsed
  end
  msg = "HTTP #{resp.status}"
  if parsed != nil and parsed["error"] != nil and parsed["error"]["message"] != nil
    msg = parsed["error"]["message"]
  elsif parsed != nil and parsed["message"] != nil
    msg = parsed["message"]
  elsif resp.body != nil and resp.body != ""
    msg = resp.body
  end
  raise NylasApiError, "Nylas API error (#{resp.status}): #{msg}"
end

def _nylas_get(client, grant_id, path, params: {})
  resp = http_get(_nylas_url(client, grant_id, path, params: params), _nylas_headers(client))
  _nylas_result(resp)
end

def _nylas_post(client, grant_id, path, body, params: {})
  resp = http_post(_nylas_url(client, grant_id, path, params: params), body, _nylas_headers(client))
  _nylas_result(resp)
end

def _nylas_put(client, grant_id, path, body, params: {})
  resp = http_put(_nylas_url(client, grant_id, path, params: params), body, _nylas_headers(client))
  _nylas_result(resp)
end

def _nylas_delete(client, grant_id, path, params: {})
  resp = http_delete(_nylas_url(client, grant_id, path, params: params), _nylas_headers(client))
  _nylas_result(resp)
end

## ── Messages ────────────────────────────────────────────────────────────

## `nylas_list_messages(client, grant_id, params:)` — params: e.g.
## {limit: 10, subject: "invoice", unread: true, in: "INBOX"}.
def nylas_list_messages(client, grant_id, params: {})
  _nylas_get(client, grant_id, "/messages", params: params)
end

def nylas_get_message(client, grant_id, message_id)
  _nylas_get(client, grant_id, "/messages/#{message_id}")
end

## `nylas_update_message(client, grant_id, message_id, body)` — e.g.
## {unread: false, starred: true, folders: ["ARCHIVE"]}.
def nylas_update_message(client, grant_id, message_id, body)
  _nylas_put(client, grant_id, "/messages/#{message_id}", body)
end

## `nylas_send_message(client, grant_id, body)` — compose and send now.
## body: {to: [{email:, name:}], subject:, body:, cc:, bcc:, reply_to:}.
def nylas_send_message(client, grant_id, body)
  _nylas_post(client, grant_id, "/messages/send", body)
end

## ── Threads ─────────────────────────────────────────────────────────────

def nylas_list_threads(client, grant_id, params: {})
  _nylas_get(client, grant_id, "/threads", params: params)
end

def nylas_get_thread(client, grant_id, thread_id)
  _nylas_get(client, grant_id, "/threads/#{thread_id}")
end

## `nylas_update_thread(client, grant_id, thread_id, body)` — e.g.
## {unread: false, starred: true, folders: ["ARCHIVE"]}.
def nylas_update_thread(client, grant_id, thread_id, body)
  _nylas_put(client, grant_id, "/threads/#{thread_id}", body)
end

## ── Drafts ──────────────────────────────────────────────────────────────

def nylas_list_drafts(client, grant_id, params: {})
  _nylas_get(client, grant_id, "/drafts", params: params)
end

def nylas_get_draft(client, grant_id, draft_id)
  _nylas_get(client, grant_id, "/drafts/#{draft_id}")
end

## `nylas_create_draft(client, grant_id, body)` — same shape as
## nylas_send_message's body, just saved instead of sent.
def nylas_create_draft(client, grant_id, body)
  _nylas_post(client, grant_id, "/drafts", body)
end

def nylas_update_draft(client, grant_id, draft_id, body)
  _nylas_put(client, grant_id, "/drafts/#{draft_id}", body)
end

def nylas_delete_draft(client, grant_id, draft_id)
  _nylas_delete(client, grant_id, "/drafts/#{draft_id}")
end

