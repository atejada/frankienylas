end

## `nylas_create_contact(client, grant_id, body)` — body: e.g.
## {given_name:, surname:, emails: [{email:, type:}]}.
def nylas_create_contact(client, grant_id, body)
  _nylas_post(client, grant_id, "/contacts", body)
end

def nylas_update_contact(client, grant_id, contact_id, body)
